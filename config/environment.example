# =============================================
# Rwanda Water Resources Board - Supabase Configuration
# Copy this file to .env.local and fill in your values
# =============================================

# Supabase Project Settings
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ovlsblmbiwcqtkssnbpv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im92bHNibG1iaXdjcXRrc3NuYnB2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTIxMzEzMDIsImV4cCI6MjA2NzcwNzMwMn0.4bAQ1lZ2571gYSFjq59h5CsnBGcu3qvKt4CS1a_eZpo

# Supabase Service Role Key (Server-side only)
# ⚠️  NEVER expose this in client-side code
# Found in: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Database Connection (Optional)
# Found in: Supabase Dashboard → Settings → Database
DATABASE_URL=your_supabase_database_url_here

# =============================================
# Application Configuration
# =============================================

# Environment
NODE_ENV=development

# App URL (for redirects, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================
# Optional: External Services
# =============================================

# Email Service (for notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@rwb.gov.rw

# SMS Service (for notifications)
SMS_API_KEY=
SMS_SENDER_ID=RWB

# File Storage (if using external storage)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# =============================================
# Security & Authentication
# =============================================

# JWT Secret (for additional security)
JWT_SECRET=your_jwt_secret_here

# Session Secret
SESSION_SECRET=your_session_secret_here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourapp.com

# =============================================
# Development Tools
# =============================================

# Enable debug logging
DEBUG=false

# Database logging
DATABASE_LOGGING=false

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# =============================================
# Rwanda-Specific Configuration
# =============================================

# Default timezone
TZ=Africa/Kigali

# Default language
DEFAULT_LANGUAGE=en

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,fr,rw

# Government Integration (if applicable)
IREMBO_API_KEY=
IREMBO_API_URL=

# =============================================
# IremboPay Payment Integration
# =============================================

# IremboPay Environment (set to 'false' for production)
IREMBOPAY_SANDBOX=true

# IremboPay API Keys
# Get these from: https://dashboard.sandbox.irembopay.com/auth/login
# Dashboard -> Integration Details -> View Token
IREMBOPAY_API_KEY=your_irembopay_api_key_here
NEXT_PUBLIC_IREMBOPAY_PUBLIC_KEY=your_irembopay_public_key_here

# IremboPay Webhook Secret (for signature validation)
IREMBOPAY_WEBHOOK_SECRET=your_webhook_secret_here

# IremboPay API URLs (auto-selected based on IREMBOPAY_SANDBOX)
# Sandbox: https://api.sandbox.irembopay.com
# Production: https://api.irembopay.com
IREMBOPAY_API_URL=https://api.sandbox.irembopay.com

# Application Fee Configuration
NEXT_PUBLIC_APPLICATION_FEE_AMOUNT=50
NEXT_PUBLIC_APPLICATION_FEE_CURRENCY=RWF

# Payment Callback URL (update with your domain)
IREMBOPAY_CALLBACK_URL=https://yourdomain.com/api/payments/webhook
IREMBOPAY_SUCCESS_URL=https://yourdomain.com/dashboard?payment=success
IREMBOPAY_FAILURE_URL=https://yourdomain.com/dashboard?payment=failed

# Payment Gateway (Legacy - for backward compatibility)
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY= 