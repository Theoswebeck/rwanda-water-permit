# Rwanda Water Resources Board - Supabase Connection
# Copy this to .env.local and .env.production and fill in your values

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Pindo.io SMS API Configuration
PINDO_API_KEY=your_pindo_api_key_here
PINDO_SENDER_NAME=Pindo

# Email (Nodemailer / Gmail SMTP) - used for application status updates & verification emails
# Interim: uses RWB Gmail account (nizzogentl1@gmail.com) via App Password.
# Future migration: set SMTP_HOST=localhost, clear SMTP_USER/PASS, update EMAIL_FROM
# once SPF/DKIM/PTR DNS records are configured for rwb.rw and Postfix is running on the server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nizzogentl1@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=Rwanda Water Resources Board <nizzogentl1@gmail.com>
EMAIL_REPLY_TO=notification.permit@rwb.rw
SUPPORT_EMAIL=info@rwb.rw
ORG_NAME=Rwanda Water Resources Board

# Public app URL (used in notification emails)
NEXT_PUBLIC_APP_URL=https://permit.rwb.rw

# IremboPay Payment Gateway Configuration
# Get these from IremboPay Dashboard
NEXT_PUBLIC_IREMBOPAY_PUBLIC_KEY=your_public_key_here
IREMBOPAY_SECRET_KEY=your_secret_key_here
IREMBOPAY_WEBHOOK_SECRET=your_webhook_secret_here
IREMBOPAY_PRODUCT_CODE=WATER_PERMIT_FEE
IREMBOPAY_ACCOUNT_ID=RWANDA_WATER_BOARD 
#
# Environment selection
# - When true, uses sandbox endpoints for both server + client widget
# - In production, set these to false (or omit and set IREMBOPAY_API_URL to production)
NEXT_PUBLIC_IREMBOPAY_SANDBOX=true
IREMBOPAY_SANDBOX=true
#
# Client widget tuning
# - Increase this if users have slow networks or corporate proxies.
NEXT_PUBLIC_IREMBOPAY_SCRIPT_TIMEOUT_MS=15000

# Demo-only: Simulate successful payment after invoice creation.
# Use ONLY for demos when IremboPay sandbox checkout is unreliable.
# When true:
# - Server marks payment as completed immediately after invoice creation
# - Application is moved to 'submitted'
# - UI redirects user to /dashboard as if payment succeeded
NEXT_PUBLIC_PAYMENT_DEMO_MODE=false
PAYMENT_DEMO_MODE=false

# Demo-only: How long to keep the Irembo modal open (ms) before auto-close + redirect
# after invoice creation.
# (Deprecated: demo completion now happens during status polling; see PAYMENT_DEMO_COMPLETE_AFTER_MS.)
# NEXT_PUBLIC_PAYMENT_DEMO_REDIRECT_DELAY_MS=2500

# Demo-only: Auto-complete payment after N ms during polling (server-side).
# Set to 0 to disable delay and see immediate events (for debugging).
# Default: 18000ms (18 seconds) - tripled from original 6000ms
PAYMENT_DEMO_COMPLETE_AFTER_MS=18000

# Heartbeat / keep-warm configuration
# - Client heartbeat runs only while a tab is open and visible
# - Server-side scheduler depends on platform (Vercel uses vercel.json crons; Railway pings healthcheck)
NEXT_PUBLIC_ENABLE_CLIENT_HEARTBEAT=true
NEXT_PUBLIC_CLIENT_HEARTBEAT_INTERVAL_MS=30000

# Optional: warm multiple routes in one hit (comma-separated)
WARMUP_ROUTES=/api/health