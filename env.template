# Rwanda Water Board - Supabase Connection
# Copy this to .env.local and .env.production and fill in your values

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Pindo.io SMS API Configuration
PINDO_API_KEY=your_pindo_api_key_here
PINDO_SENDER_NAME=Pindo

# Email (Resend) - used for application status updates & verification emails
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=nouru@menlohq.com
SUPPORT_EMAIL=contact@rwb.rw

# Public app URL (used in notification emails)
NEXT_PUBLIC_APP_URL=https://permit.rwb.rw

# IremboPay Payment Gateway Configuration
# Get these from IremboPay Dashboard
NEXT_PUBLIC_IREMBOPAY_PUBLIC_KEY=your_public_key_here
IREMBOPAY_SECRET_KEY=your_secret_key_here
IREMBOPAY_WEBHOOK_SECRET=your_webhook_secret_here
IREMBOPAY_PRODUCT_CODE=WATER_PERMIT_FEE
IREMBOPAY_ACCOUNT_ID=RWANDA_WATER_BOARD 
#
# Environment selection
# - When true, uses sandbox endpoints for both server + client widget
# - In production, set these to false (or omit and set IREMBOPAY_API_URL to production)
NEXT_PUBLIC_IREMBOPAY_SANDBOX=true
IREMBOPAY_SANDBOX=true
#
# Client widget tuning
# - Increase this if users have slow networks or corporate proxies.
NEXT_PUBLIC_IREMBOPAY_SCRIPT_TIMEOUT_MS=15000

# Heartbeat / keep-warm configuration
# - Client heartbeat runs only while a tab is open and visible
# - Server-side scheduler depends on platform (Vercel uses vercel.json crons; Railway pings healthcheck)
NEXT_PUBLIC_ENABLE_CLIENT_HEARTBEAT=true
NEXT_PUBLIC_CLIENT_HEARTBEAT_INTERVAL_MS=30000

# Optional: warm multiple routes in one hit (comma-separated)
WARMUP_ROUTES=/api/health